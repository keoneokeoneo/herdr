{
  "name": "herdr",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*/mod-lib/*.test.mjs",
    "test:base": "node --test tests/base/mod-lib/*.test.mjs",
    "test:setup": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests/setup",
    "setup:list": "python3 scripts/setup.py list",
    "setup:install": "python3 scripts/setup.py install",
    "setup:status": "python3 scripts/setup.py status",
    "setup:update": "python3 scripts/setup.py update",
    "test:poke": "node --test tests/poke/mod-lib/*.test.mjs",
    "test:poke:helper": "cd helpers/poke && go test ./...",
    "test:poke:scripts": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests/poke/scripts",
    "preflight:poke": "python3 scripts/poke/preflight.py",
    "build:poke": "bash scripts/poke/build.sh",
    "install:poke": "bash scripts/poke/install.sh",
    "uninstall:poke": "bash scripts/poke/uninstall.sh"
  }
}
